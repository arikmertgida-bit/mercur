{
  "name": "mercur",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --quiet",
    "test:unit": "cd integration-tests && bun run test:unit",
    "test:integration:http": "cd integration-tests && bun run test:integration:http"
  },
  "dependencies": {
    "@mercurjs/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "oxlint": "^1.95.0",
    "pg-god": "^1.0.12",
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*",
    "integration-tests",
    "e2e-tests",
    "e2e-tests/hosts/*"
  ],
  "overrides": {
    "@medusajs/admin-bundler": "2.21.2",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/admin-vite-plugin": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/core-flows": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@medusajs/types": "2.21.2",
    "@medusajs/ui": "4.2.3",
    "@medusajs/ui-preset": "2.21.2",
    "zod": "4.6.7",
    "tailwindcss": "3.4.19",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.9",
    "compression": "1.8.2",
    "axios": "1.21.1",
    "form-data": "4.0.6",
    "follow-redirects": "1.16.3",
    "@grpc/grpc-js": "1.14.7",
    "immutable": "5.1.10",
    "joi": "18.3.2",
    "figlet": "1.12.0",
    "lodash": "4.18.1",
    "multer": "2.5.0",
    "http-proxy-middleware": "3.0.11",
    "nanoid": "3.3.20",
    "postcss": "8.5.33",
    "source-map-js": "1.2.4",
    "browserslist": "4.29.6",
    "qs": "6.17.1",
    "protobufjs": "7.6.6",
    "dompurify": "3.4.18",
    "react-router": "7.18.6",
    "react-router-dom": "7.18.6",
    "@graphql-tools/utils": "13.2.2",
    "csstype": "3.2.3"
  }
}
