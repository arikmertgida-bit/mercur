{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".medusa/**", "!**/cache/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "STORE_CORS",
        "ADMIN_CORS",
        "VENDOR_CORS",
        "AUTH_CORS",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "MINIO_ENDPOINT",
        "MINIO_FILE_URL",
        "MINIO_PUBLIC_URL",
        "MINIO_ACCESS_KEY_ID",
        "MINIO_SECRET_ACCESS_KEY",
        "MINIO_BUCKET",
        "MINIO_REGION",
        "MEILISEARCH_HOST",
        "MEILISEARCH_MASTER_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test:integration:http": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
