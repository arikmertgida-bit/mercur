{
  "name": "@acme/api",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "exports": {
    "./_generated": {
      "types": "./.mercur/routes.d.ts"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js"
  },
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "bun ../../packages/cli/dist/index.js codegen && medusa build",
    "check-types": "tsc --noEmit",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/cli": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/dashboard": "2.17.2",
    "@medusajs/admin-shared": "2.17.2",
    "@medusajs/medusa": "2.17.2",
    "@medusajs/draft-order": "2.17.2",
    "@medusajs/core-flows": "2.17.2",
    "@aws-sdk/client-s3": "^3.556.0",
    "@aws-sdk/lib-storage": "^3.556.0",
    "@aws-sdk/s3-request-presigner": "^3.556.0",
    "ulid": "^2.3.0",
    "@mercurjs/core": "*",
    "@mercurjs/types": "*",
    "http-proxy-middleware": "^3.0.3",
    "@mercurjs/cli": "*",
    "@mercurjs/docs": "*",
    "jsonwebtoken": "9.0.2",
    "meilisearch": "^0.59.0",
    "multer": "^2.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.17.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.1.0",
    "jest": "^30.4.2",
    "prop-types": "^15.8.1",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
